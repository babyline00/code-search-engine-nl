# Prisma SQLite — ABSOLUTE path (relative paths break when running scripts from
# different working directories). Replace with your own absolute path.
DATABASE_URL="file:/home/z/my-project/apps/65-code-search-engine-nl/db/custom.db"

# --- Optional: real LLM provider for the "Explain this snippet" feature ---
# When unset, the app falls back to a deterministic hashing embedder + a mock
# explainer that echoes the snippet back. Set these to enable real LLM calls
# via the z-ai-web-dev-sdk sandbox gateway.
# ZAI_API_KEY=""
# ZAI_BASE_URL=""

# --- Optional: real embeddings (otherwise hashing-trick embedder is used) ---
# EMBEDDINGS_API_KEY=""
# EMBEDDINGS_BASE_URL="https://api.openai.com/v1"
# EMBEDDINGS_MODEL="text-embedding-3-small"
